PORT=5000
MONGODB_URI=
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app,https://*.vercel.app
DEMO_MODE=false
# DEMO_MODE=true wipes and re-seeds the connected database. Never use it on data you want to keep.
# DEMO_LOGIN=true enables the one-click demo login on existing data (no seeding).
DEMO_LOGIN=true
DEMO_ROLE=admin
